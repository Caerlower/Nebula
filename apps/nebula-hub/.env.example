# --- App ---
# Production: set both to the public HTTPS origin (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Deliberate deploy default: testnet | mainnet. Per-account preference overrides
# this via User.preferredNetwork (NetworkChip / PATCH /api/me).
STELLAR_NETWORK=testnet
# Optional kill-switch: MAINNET_ENABLED=0 blocks preferring mainnet.
# MAINNET_ENABLED=1
# Native XLM reserved for fees when depositing to Blend (default 5)
# XLM_FEE_BUFFER=5
# Blend v2 pools are pinned in code from blend-utils (testnet TestnetV2, mainnet Fixed + YieldBlox).

# --- Private beta (disabled) ---
# Product routes no longer require an invite cookie. Optional: keep codes if
# you re-enable the gate or protect GET /api/waitlist listing.
# NEBULA_BETA_CODES=NEBULA-CREW

# --- Supabase (waitlist REST) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Prisma / Supabase Postgres ---
DATABASE_URL=
DIRECT_URL=
# Cap Prisma pool size (default: 5 in dev, 3 in prod). Raises if you see P2024 pool timeouts.
# PRISMA_CONNECTION_LIMIT=5

# --- Privy (login + server wallets / signing) ---
# Client (must match PRIVY_APP_ID)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization key from Privy Dashboard → Wallet infrastructure → Keys and quorums → New key.
# Usually looks like: wallet-auth:MIGHAgEAMBMGByqGSM49AgEGCCqG...
# (Privy does not store the private key — copy it when creating.)
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# --- On-chain spending policy (Soroban nebula-policy) ---
# Deploy wasm from contracts/policy, then set the network-specific contract id.
# Mainnet is deployed — set POLICY_CONTRACT_ID_MAINNET to enable on-chain check_spend.
# POLICY_CONTRACT_ID_TESTNET=CAWKC7IEHVKM5V5JVXJE4HNWCM5CHZZHFYH33W5O7EEEQIND6TJ3CD2F
# POLICY_CONTRACT_ID_MAINNET=CCPXPACO3V2FISPN5CY5LGFSU7XI5QBVMHOC25ITJVTCIF2P3OCNILWU
# Legacy testnet-only fallback (ignored for mainnet):
# POLICY_CONTRACT_ID=CAWKC7IEHVKM5V5JVXJE4HNWCM5CHZZHFYH33W5O7EEEQIND6TJ3CD2F

# --- Wallet-native sign-in (Freighter / EOA) ---
# HMAC secret for the stateless SIWS challenge + session cookie. REQUIRED in
# production (the app throws on wallet sign-in without it). Generate with:
#   openssl rand -hex 32
WALLET_SESSION_SECRET=

# --- Partner signing (Tael) ---
# For partner_callback agents (e.g. Tael cards), Nebula never holds the key:
# each spend hash is POSTed to the partner's sign endpoint (HMAC-authenticated),
# the partner validates the card's caps and signs, Nebula submits.
# When unset, partner spends return "signer not configured"; reads + Privy agents
# are unaffected.
# TAEL_PARTNER_SIGN_URL=https://<tael-gateway>/partner/sign
# TAEL_HMAC_SECRET=
# Optional partner id echoed as x-nebula-partner header.
# TAEL_PARTNER_ID=nebula

# --- x402 (optional overrides) ---
# STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_MAINNET_RPC_URL=https://mainnet.sorobanrpc.com
# Buyer wallets need a Circle USDC trustline + balance (testnet: Circle faucet).

# --- MPP channels (optional) ---
# Default recipient when mpp_open_session omits recipient:
# MPP_RECIPIENT=G...
# Optional override for channel.wasm path (defaults to apps/nebula-hub/contracts/channel.wasm):
# MPP_CHANNEL_WASM_PATH=
# Demo merchant at /api/mpp-demo/[channel] — disabled unless this is set (no default).
# MPP_DEMO_SECRET=
# MPP_DEMO_PRICE=0.01

# --- OAuth DCR (MCP Dynamic Client Registration) ---
# open = any https + localhost (legacy). restricted (default) = localhost /
# loopback / private IPs / optional allowlist only. disabled = 404.
# OAUTH_DCR_MODE=restricted
# Comma-separated extra https hosts allowed when restricted.
# Claude.ai (claude.ai / www.claude.ai) is always allowed in code — no need
# to list it here. Add other hosts as needed, e.g. cursor.sh
# OAUTH_DCR_REDIRECT_HOSTS=
# Optional shared secret: require Authorization: Bearer <secret> to register.
# OAUTH_DCR_SECRET=

# --- Stellar8004 (on-chain agent identity / reputation) ---
# Optional explorer override (default https://stellar8004.com):
# STELLAR8004_EXPLORER_URL=https://stellar8004.com
# Optional metadata defaults for register_identity:
# AGENT8004_NAME=Nebula Agent
# AGENT8004_DESCRIPTION=Autonomous Stellar agent wallet
# AGENT8004_IMAGE_URL=

# --- Fianza (formerly TrustLine — revenue-underwritten USDC credit) ---
# Docs: https://docs.0xtrustline.online  · SDK: @fianza/agent-sdk / @trustline-agents/agent-sdk
# Hub wraps the same protocol with Privy signing (no agent secret keys).
# Runtime is testnet-only until Fianza’s pubnet API ships; mainnet IDs pinned below.
# Enabled by default on testnet Hub; set TRUSTLINE_ENABLED=0 to hide/disable.
# TRUSTLINE_ENABLED=1
# TRUSTLINE_API_BASE_URL=https://trustline-rpxt.onrender.com
# Pinned Soroban IDs — /config must match or Hub refuses to sign (defaults = live testnet Jul 2026):
# TRUSTLINE_REGISTRY_ID=CAZUPW5MWHG5XCE7BM6YP6M52NPB6TPRRAXU3GEV4TL2AR2ZMYE7TRSX
# TRUSTLINE_CREDIT_LINE_ID=CC4ZAKREYMCDEONIQMSSBYOBFC75LL5NPYVEBRZ5SACHYWLYGK2R7GDO
# TRUSTLINE_VAULT_ID=CAMF3BS23WXYMA6W6E55VSX577GIPSRKJXJKLL2G46TABUQ4GIRGHIL3
# TRUSTLINE_USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Mainnet contracts (not wired in Hub until FIANZA_MAINNET_ENABLED + pubnet API):
# FIANZA_REGISTRY_ID_MAINNET=CAHWYFLMQI6BBOL6ZLZRRINCK6KVBX73ACH7LCPB24WDED4LSMCI7YZC
# FIANZA_CREDIT_LINE_ID_MAINNET=CDK7S4UWY227FHFKDSV37DGT7AIJ5Z2QEYO5AY456M7RBGJN25WYJVGC
# FIANZA_VAULT_ID_MAINNET=CAE5C5UJYVED5DAVY4YKYT6E2C4NBZCIUBAK2MXGKGLKZESBBXKFPZ4U
# FIANZA_USDC_SAC_MAINNET=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# Optional fixed XLM/USD for spend-cap conversion (skips CoinGecko). Tests / offline only.
# Live path uses CoinGecko: GET https://api.coingecko.com/api/v3/simple/price?ids=stellar&vs_currencies=usd
# XLM_USD_PRICE=0.12

# --- Optional rate limits ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Local demos ONLY — never set on Vercel / production ---
# Full auth bypass via x-nebula-dev-mint. Ignored when NODE_ENV=production or VERCEL=1.
# DEV_MINT_SECRET=
# DEV_USER_EMAIL=dev@nebula.local
